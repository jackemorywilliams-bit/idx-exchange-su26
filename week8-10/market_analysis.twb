<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='20262.26.0708.1337' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Market Sold (Flagged)' inline='true' name='federated.sold' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Market Sold (Flagged)' name='hyper.federated.sold'>
            <connection class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/market_sold.hyper' schema='Extract' sslmode='' username='tableau_internal_user' />
          </named-connection>
        </named-connections>
        <relation connection='hyper.federated.sold' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <column caption='Close Date' datatype='date' name='[CloseDate]' role='dimension' type='ordinal' />
      <column caption='Closed Sale' datatype='string' name='[YrMo]' role='dimension' type='nominal' />
      <column caption='Close Price' datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;(&quot;$&quot;#,##0,,.00M)' name='[ClosePrice]' role='measure' type='quantitative' />
      <column caption='Close-to-List Ratio' datatype='real' default-format='n#,##0.000;-#,##0.000' name='[price_ratio]' role='measure' type='quantitative' />
      <column caption='Days on Market' datatype='real' default-format='n#,##0;-#,##0' name='[days_on_market]' role='measure' type='quantitative' />
      <column datatype='string' name='[City]' role='dimension' type='nominal' />
      <column caption='County' datatype='string' name='[CountyOrParish]' role='dimension' type='nominal' />
      <column caption='Zip Code' datatype='string' name='[PostalCode]' role='dimension' type='nominal' />
      <column caption='Property Type' datatype='string' name='[PropertySubType]' role='dimension' type='nominal' />
      <column datatype='string' name='[DistrictName]' role='dimension' type='nominal' />
      <column datatype='integer' name='[any_iqr_outlier_flag]' role='dimension' type='ordinal' />
      <column caption='30-yr Mortgage Rate' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[rate_30yr_fixed]' role='measure' type='quantitative' />
      <column caption='Rank' datatype='integer' name='[county_sold_rank]' role='dimension' type='ordinal' />
      <extract count='-1' enabled='true' units='records'>
        <connection access_mode='readonly' class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/market_sold.hyper' default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='tableau_internal_user'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
      </extract>
    </datasource>
    <datasource caption='Market Listings (Flagged)' inline='true' name='federated.listings' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Market Listings (Flagged)' name='hyper.federated.listings'>
            <connection class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/market_listings.hyper' schema='Extract' sslmode='' username='tableau_internal_user' />
          </named-connection>
        </named-connections>
        <relation connection='hyper.federated.listings' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <column caption='Listing Date' datatype='date' name='[ListingContractDate]' role='dimension' type='ordinal' />
      <column caption='New Listing' datatype='string' name='[ListYrMo]' role='dimension' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' type='nominal' />
      <column caption='County' datatype='string' name='[CountyOrParish]' role='dimension' type='nominal' />
      <column caption='Zip Code' datatype='string' name='[PostalCode]' role='dimension' type='nominal' />
      <column caption='Property Type' datatype='string' name='[PropertySubType]' role='dimension' type='nominal' />
      <column datatype='integer' name='[any_iqr_outlier_flag]' role='dimension' type='ordinal' />
      <column caption='Rank' datatype='integer' name='[listing_subtype_rank]' role='dimension' type='ordinal' />
      <extract count='-1' enabled='true' units='records'>
        <connection access_mode='readonly' class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/market_listings.hyper' default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='tableau_internal_user'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
      </extract>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Median Close Price'>
      <layout-options>
        <title>
          <formatted-text><run>Median Close Price by Month (all sold rows)</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Market Sold (Flagged)' name='federated.sold' />
          </datasources>
          <datasource-dependencies datasource='federated.sold'>
            <column caption='Close Date' datatype='date' name='[CloseDate]' role='dimension' type='ordinal' />
            <column caption='Close Price' datatype='real' name='[ClosePrice]' role='measure' type='quantitative' />
            
            <column-instance column='[CountyOrParish]' derivation='None' name='[none:CountyOrParish:nk]' pivot='key' type='nominal' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[PostalCode]' derivation='None' name='[none:PostalCode:nk]' pivot='key' type='nominal' />
            <column-instance column='[PropertySubType]' derivation='None' name='[none:PropertySubType:nk]' pivot='key' type='nominal' />
            <column-instance column='[CloseDate]' derivation='Month-Trunc' name='[tmn:CloseDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ClosePrice]' derivation='Median' name='[med:ClosePrice:qk]' pivot='key' type='quantitative' />
            
          </datasource-dependencies>
          <filter class='categorical' column='[federated.sold].[none:CountyOrParish:nk]' filter-group='1'><groupfilter function='level-members' level='[none:CountyOrParish:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:City:nk]' filter-group='2'><groupfilter function='level-members' level='[none:City:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:PostalCode:nk]' filter-group='3'><groupfilter function='level-members' level='[none:PostalCode:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:PropertySubType:nk]' filter-group='4'><groupfilter function='level-members' level='[none:PropertySubType:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <slices>
            <column>[federated.sold].[none:CountyOrParish:nk]</column>
            <column>[federated.sold].[none:City:nk]</column>
            <column>[federated.sold].[none:PostalCode:nk]</column>
            <column>[federated.sold].[none:PropertySubType:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <text column='[federated.sold].[med:ClosePrice:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-mode' value='all' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.sold].[med:ClosePrice:qk]</rows>
        <cols>[federated.sold].[tmn:CloseDate:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Close-to-List Ratio'>
      <layout-options>
        <title>
          <formatted-text><run>Avg Close-to-Original-List Ratio (IQR-filtered; ratios above 2 excluded: 552 rows, 0.14%)</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Market Sold (Flagged)' name='federated.sold' />
          </datasources>
          <datasource-dependencies datasource='federated.sold'>
            <column caption='Close Date' datatype='date' name='[CloseDate]' role='dimension' type='ordinal' />
            <column caption='Close-to-List Ratio' datatype='real' name='[price_ratio]' role='measure' type='quantitative' />
            
            <column-instance column='[CountyOrParish]' derivation='None' name='[none:CountyOrParish:nk]' pivot='key' type='nominal' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[PostalCode]' derivation='None' name='[none:PostalCode:nk]' pivot='key' type='nominal' />
            <column-instance column='[PropertySubType]' derivation='None' name='[none:PropertySubType:nk]' pivot='key' type='nominal' />
            <column-instance column='[any_iqr_outlier_flag]' derivation='None' name='[none:any_iqr_outlier_flag:ok]' pivot='key' type='ordinal' />
            <column-instance column='[price_ratio]' derivation='None' name='[none:price_ratio:qk]' pivot='key' type='quantitative' />
            <column-instance column='[CloseDate]' derivation='Month-Trunc' name='[tmn:CloseDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[price_ratio]' derivation='Avg' name='[avg:price_ratio:qk]' pivot='key' type='quantitative' />
            
          </datasource-dependencies>
          <filter class='categorical' column='[federated.sold].[none:CountyOrParish:nk]' filter-group='1'><groupfilter function='level-members' level='[none:CountyOrParish:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:City:nk]' filter-group='2'><groupfilter function='level-members' level='[none:City:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:PostalCode:nk]' filter-group='3'><groupfilter function='level-members' level='[none:PostalCode:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:PropertySubType:nk]' filter-group='4'><groupfilter function='level-members' level='[none:PropertySubType:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:any_iqr_outlier_flag:ok]'><groupfilter function='member' level='[none:any_iqr_outlier_flag:ok]' member='0' /></filter>
          <filter class='quantitative' column='[federated.sold].[none:price_ratio:qk]' included-values='in-range'><min>0</min><max>2</max></filter>
          <slices>
            <column>[federated.sold].[none:CountyOrParish:nk]</column>
            <column>[federated.sold].[none:City:nk]</column>
            <column>[federated.sold].[none:PostalCode:nk]</column>
            <column>[federated.sold].[none:PropertySubType:nk]</column>
            <column>[federated.sold].[none:any_iqr_outlier_flag:ok]</column>
            <column>[federated.sold].[none:price_ratio:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
            <encodings>
              <text column='[federated.sold].[avg:price_ratio:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-mode' value='all' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.sold].[avg:price_ratio:qk]</rows>
        <cols>[federated.sold].[tmn:CloseDate:qk]</cols>
      </table>
    </worksheet>
