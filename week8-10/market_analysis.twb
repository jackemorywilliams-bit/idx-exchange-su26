        <connection access_mode='readonly' class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/market_listings.hyper' default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='tableau_internal_user'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
      </extract>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Monthly Median Close Price'>
      <layout-options>
        <title>
          <formatted-text><run>Monthly Median Close Price (all sold rows)</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Market Sold (Flagged)' name='federated.sold' />
          </datasources>
          <datasource-dependencies datasource='federated.sold'>
            <column datatype='date' name='[CloseDate]' role='dimension' type='ordinal' />
            <column datatype='real' name='[ClosePrice]' role='measure' type='quantitative' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[CountyOrParish]' derivation='None' name='[none:CountyOrParish:nk]' pivot='key' type='nominal' />
            <column-instance column='[PostalCode]' derivation='None' name='[none:PostalCode:nk]' pivot='key' type='nominal' />
            <column-instance column='[PropertySubType]' derivation='None' name='[none:PropertySubType:nk]' pivot='key' type='nominal' />

            <column-instance column='[CloseDate]' derivation='Month-Trunc' name='[tmn:CloseDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ClosePrice]' derivation='Median' name='[med:ClosePrice:qk]' pivot='key' type='quantitative' />
            
          </datasource-dependencies>
          <filter class='categorical' column='[federated.sold].[none:City:nk]'><groupfilter function='level-members' level='[none:City:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:CountyOrParish:nk]'><groupfilter function='level-members' level='[none:CountyOrParish:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:PostalCode:nk]'><groupfilter function='level-members' level='[none:PostalCode:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:PropertySubType:nk]'><groupfilter function='level-members' level='[none:PropertySubType:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>

          <slices>
            <column>[federated.sold].[none:City:nk]</column>
            <column>[federated.sold].[none:CountyOrParish:nk]</column>
            <column>[federated.sold].[none:PostalCode:nk]</column>
            <column>[federated.sold].[none:PropertySubType:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.sold].[med:ClosePrice:qk]</rows>
        <cols>[federated.sold].[tmn:CloseDate:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Average Days on Market'>
      <layout-options>
        <title>
          <formatted-text><run>Average Days on Market - mean of MLS days_on_market, IQR-filtered</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Market Sold (Flagged)' name='federated.sold' />
          </datasources>
          <datasource-dependencies datasource='federated.sold'>
            <column datatype='date' name='[CloseDate]' role='dimension' type='ordinal' />
            <column datatype='real' name='[days_on_market]' role='measure' type='quantitative' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[CountyOrParish]' derivation='None' name='[none:CountyOrParish:nk]' pivot='key' type='nominal' />
            <column-instance column='[PostalCode]' derivation='None' name='[none:PostalCode:nk]' pivot='key' type='nominal' />
            <column-instance column='[PropertySubType]' derivation='None' name='[none:PropertySubType:nk]' pivot='key' type='nominal' />
            <column-instance column='[any_iqr_outlier_flag]' derivation='None' name='[none:any_iqr_outlier_flag:ok]' pivot='key' type='ordinal' />
            <column-instance column='[CloseDate]' derivation='Month-Trunc' name='[tmn:CloseDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[days_on_market]' derivation='Avg' name='[avg:days_on_market:qk]' pivot='key' type='quantitative' />
            
          </datasource-dependencies>
          <filter class='categorical' column='[federated.sold].[none:City:nk]'><groupfilter function='level-members' level='[none:City:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:CountyOrParish:nk]'><groupfilter function='level-members' level='[none:CountyOrParish:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:PostalCode:nk]'><groupfilter function='level-members' level='[none:PostalCode:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:PropertySubType:nk]'><groupfilter function='level-members' level='[none:PropertySubType:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:any_iqr_outlier_flag:ok]'><groupfilter function='member' level='[none:any_iqr_outlier_flag:ok]' member='0' /></filter>
          <slices>
            <column>[federated.sold].[none:City:nk]</column>
            <column>[federated.sold].[none:CountyOrParish:nk]</column>
            <column>[federated.sold].[none:PostalCode:nk]</column>
            <column>[federated.sold].[none:PropertySubType:nk]</column>
            <column>[federated.sold].[none:any_iqr_outlier_flag:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.sold].[avg:days_on_market:qk]</rows>
        <cols>[federated.sold].[tmn:CloseDate:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='Average Close-to-Original-List Ratio'>
      <layout-options>
        <title>
          <formatted-text><run>Avg Close-to-Original-List Ratio - AVG of per-sale ratio, IQR-filtered; ratios above 2 excluded (552 rows, 0.14%, data-entry artifacts)</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Market Sold (Flagged)' name='federated.sold' />
          </datasources>
          <datasource-dependencies datasource='federated.sold'>
            <column datatype='date' name='[CloseDate]' role='dimension' type='ordinal' />
            <column datatype='real' name='[price_ratio]' role='measure' type='quantitative' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[CountyOrParish]' derivation='None' name='[none:CountyOrParish:nk]' pivot='key' type='nominal' />
            <column-instance column='[PostalCode]' derivation='None' name='[none:PostalCode:nk]' pivot='key' type='nominal' />
            <column-instance column='[PropertySubType]' derivation='None' name='[none:PropertySubType:nk]' pivot='key' type='nominal' />
            <column-instance column='[any_iqr_outlier_flag]' derivation='None' name='[none:any_iqr_outlier_flag:ok]' pivot='key' type='ordinal' />
            <column-instance column='[price_ratio]' derivation='None' name='[none:price_ratio:qk]' pivot='key' type='quantitative' />
            <column-instance column='[CloseDate]' derivation='Month-Trunc' name='[tmn:CloseDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[price_ratio]' derivation='Avg' name='[avg:price_ratio:qk]' pivot='key' type='quantitative' />
            
          </datasource-dependencies>
          <filter class='categorical' column='[federated.sold].[none:City:nk]'><groupfilter function='level-members' level='[none:City:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:CountyOrParish:nk]'><groupfilter function='level-members' level='[none:CountyOrParish:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:PostalCode:nk]'><groupfilter function='level-members' level='[none:PostalCode:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:PropertySubType:nk]'><groupfilter function='level-members' level='[none:PropertySubType:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.sold].[none:any_iqr_outlier_flag:ok]'><groupfilter function='member' level='[none:any_iqr_outlier_flag:ok]' member='0' /></filter>
          <filter class='quantitative' column='[federated.sold].[none:price_ratio:qk]' included-values='in-range'><min>0</min><max>2</max></filter>
          <slices>
            <column>[federated.sold].[none:City:nk]</column>
            <column>[federated.sold].[none:CountyOrParish:nk]</column>
            <column>[federated.sold].[none:PostalCode:nk]</column>
            <column>[federated.sold].[none:PropertySubType:nk]</column>
            <column>[federated.sold].[none:any_iqr_outlier_flag:ok]</column>
            <column>[federated.sold].[none:price_ratio:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.sold].[avg:price_ratio:qk]</rows>
        <cols>[federated.sold].[tmn:CloseDate:qk]</cols>
      </table>
    </worksheet>
