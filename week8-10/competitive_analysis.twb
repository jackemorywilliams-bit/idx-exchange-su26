            <format attr='font-size' value='9' />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.agents].[Multiple Values]' />
            </encodings>
          </pane>
        </panes>
        <rows>([federated.agents].[none:rank_volume:nk] / [federated.agents].[none:display:nk])</rows>
        <cols>[federated.agents].[:Measure Names]</cols>
      </table>
    </worksheet>
