          <filter class='categorical' column='[federated.csold].[none:sentinel_flag:ok]'><groupfilter function='member' level='[none:sentinel_flag:ok]' member='0' /></filter>
          <filter class='quantitative' column='[federated.csold].[none:office_rank_units:qk]' included-values='in-range'><min>1</min><max>100</max></filter>
          <slices>
            <column>[federated.csold].[none:CountyOrParish:nk]</column>
            <column>[federated.csold].[none:City:nk]</column>
            <column>[federated.csold].[none:PostalCode:nk]</column>
            <column>[federated.csold].[none:PropertySubType:nk]</column>
            <column>[federated.csold].[:Measure Names]</column>
            <column>[federated.csold].[none:sentinel_flag:ok]</column>
            <column>[federated.csold].[none:office_rank_units:qk]</column>
          </slices>
          <aggregation value='true' />
