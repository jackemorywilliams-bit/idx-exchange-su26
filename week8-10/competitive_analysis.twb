<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='20262.26.0708.1337' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <datasources>
    <datasource caption='Competitive Sold (row-level)' inline='true' name='federated.csold' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Competitive Sold (row-level)' name='hyper.federated.csold'>
            <connection class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/competitive_sold.hyper' schema='Extract' sslmode='' username='tableau_internal_user' />
          </named-connection>
        </named-connections>
        <relation connection='hyper.federated.csold' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <column caption='Close Date' datatype='date' name='[CloseDate]' role='dimension' type='ordinal' />
      <column caption='Month' datatype='string' name='[YrMo]' role='dimension' type='nominal' />
      <column caption='Sales Volume' datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;(&quot;$&quot;#,##0,,.00M)' name='[ClosePrice]' role='measure' type='quantitative' />
      <column datatype='string' name='[City]' role='dimension' type='nominal' />
      <column caption='County' datatype='string' name='[CountyOrParish]' role='dimension' type='nominal' />
      <column caption='Zip Code' datatype='string' name='[PostalCode]' role='dimension' semantic-role='[ZipCode].[Name]' type='nominal' />
      <column caption='Property Type' datatype='string' name='[PropertySubType]' role='dimension' type='nominal' />
      <column caption='Listing Office' datatype='string' name='[office_display]' role='dimension' type='nominal' />
      <column caption='Units Sold' datatype='integer' default-format='n#,##0;-#,##0' name='[unit]' role='measure' type='quantitative' />
      <column datatype='string' name='[office_key]' role='dimension' type='nominal' />
      <column caption='Brokerage' datatype='string' name='[brokerage]' role='dimension' type='nominal' />
      <column datatype='integer' name='[sentinel_flag]' role='dimension' type='ordinal' />
      <column datatype='integer' name='[zip_rank]' role='dimension' type='ordinal' />
      <column caption='Rank' datatype='integer' name='[office_rank_units]' role='dimension' type='ordinal' />
      <column caption='Rank' datatype='integer' name='[office_rank_volume]' role='dimension' type='ordinal' />
      <column caption='Market Share %' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[Calculation_share]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([unit]) / SUM({ EXCLUDE [office_display] : SUM([unit]) }) * 100' />
      </column>
      <extract count='-1' enabled='true' units='records'>
        <connection access_mode='readonly' class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/competitive_sold.hyper' default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='tableau_internal_user'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
      </extract>
    </datasource>
    <datasource caption='Top Listing Agents (precomputed)' inline='true' name='federated.agents' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Top Listing Agents (precomputed)' name='hyper.federated.agents'>
            <connection class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/top_agents.hyper' schema='Extract' sslmode='' username='tableau_internal_user' />
          </named-connection>
        </named-connections>
        <relation connection='hyper.federated.agents' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <column caption='Listing Agent, Office' datatype='string' name='[display]' role='dimension' type='nominal' />
      <column caption='Units Sold' datatype='integer' default-format='n#,##0;-#,##0' name='[units]' role='measure' type='quantitative' />
      <column caption='Sales Volume' datatype='real' default-format='c&quot;$&quot;#,##0,,.00M;(&quot;$&quot;#,##0,,.00M)' name='[volume]' role='measure' type='quantitative' />
      <column caption='Market Share % (units)' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[share_units_pct]' role='measure' type='quantitative' />
      <column caption='Market Share % (volume)' datatype='real' default-format='n#,##0.00&quot;%&quot;;-#,##0.00&quot;%&quot;' name='[share_volume_pct]' role='measure' type='quantitative' />
      <column caption='Rank' datatype='integer' name='[rank_units]' role='dimension' type='ordinal' />
      <column caption='Rank' datatype='integer' name='[rank_volume]' role='dimension' type='ordinal' />
      <extract count='-1' enabled='true' units='records'>
        <connection access_mode='readonly' class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/top_agents.hyper' default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='tableau_internal_user'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
      </extract>
    </datasource>
    <datasource caption='Brokerage Monthly Share (precomputed)' inline='true' name='federated.brokerages' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='Brokerage Monthly Share (precomputed)' name='hyper.federated.brokerages'>
            <connection class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/brokerage_monthly.hyper' schema='Extract' sslmode='' username='tableau_internal_user' />
          </named-connection>
        </named-connections>
        <relation connection='hyper.federated.brokerages' name='Extract' table='[Extract].[Extract]' type='table' />
      </connection>
      <column caption='Brokerage' datatype='string' name='[brokerage]' role='dimension' type='nominal' />
      <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
      <column datatype='string' name='[YrMo]' role='dimension' type='nominal' />
      <column caption='Listing Sides' datatype='integer' default-format='n#,##0;-#,##0' name='[sides]' role='measure' type='quantitative' />
      <column caption='Sales Volume' datatype='real' default-format='c&quot;$&quot;#,##0,,,.0B;(&quot;$&quot;#,##0,,,.0B)' name='[volume]' role='measure' type='quantitative' />
      <column caption='Share of Listing Sides' datatype='real' default-format='n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;' name='[share_pct]' role='measure' type='quantitative' />
      <extract count='-1' enabled='true' units='records'>
        <connection access_mode='readonly' class='hyper' dbname='/Users/emorywilliams/idx-exchange/tableau/brokerage_monthly.hyper' default-settings='yes' schema='Extract' sslmode='' tablename='Extract' username='tableau_internal_user'>
          <relation name='Extract' table='[Extract].[Extract]' type='table' />
        </connection>
      </extract>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='Agents by Units'>
      <layout-options>
        <title>
          <formatted-text><run>Top 100 Listing Agents by Units Sold (statewide, Jan 2024 - Jun 2026)</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Top Listing Agents (precomputed)' name='federated.agents' />
          </datasources>

          <datasource-dependencies datasource='federated.agents'>
            <column-instance column='[display]' derivation='None' name='[none:display:nk]' pivot='key' type='nominal' />
            <column-instance column='[rank_units]' derivation='None' name='[none:rank_units:nk]' pivot='key' type='nominal' />
            <column-instance column='[rank_units]' derivation='None' name='[none:rank_units:qk]' pivot='key' type='quantitative' />
            <column-instance column='[units]' derivation='Sum' name='[sum:units:qk]' pivot='key' type='quantitative' />
            <column-instance column='[volume]' derivation='Sum' name='[sum:volume:qk]' pivot='key' type='quantitative' />
            <column-instance column='[share_units_pct]' derivation='Sum' name='[sum:share_units_pct:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.agents].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.agents].[sum:units:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.agents].[sum:volume:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.agents].[sum:share_units_pct:qk]&quot;' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.agents].[none:rank_units:qk]' included-values='in-range'><min>1</min><max>100</max></filter>
          <slices>
            <column>[federated.agents].[:Measure Names]</column>
            <column>[federated.agents].[none:rank_units:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-size' value='9' />
          </style-rule>
          <style-rule element='header'>
            <format attr='font-size' value='9' />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.agents].[Multiple Values]' />
            </encodings>
          </pane>
        </panes>
        <rows>([federated.agents].[none:rank_units:nk] / [federated.agents].[none:display:nk])</rows>
        <cols>[federated.agents].[:Measure Names]</cols>
      </table>
    </worksheet>
    <worksheet name='Agents by Volume'>
      <layout-options>
        <title>
          <formatted-text><run>Top 100 Listing Agents by Sales Volume (statewide, Jan 2024 - Jun 2026)</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Top Listing Agents (precomputed)' name='federated.agents' />
          </datasources>

          <datasource-dependencies datasource='federated.agents'>
            <column-instance column='[display]' derivation='None' name='[none:display:nk]' pivot='key' type='nominal' />
            <column-instance column='[rank_volume]' derivation='None' name='[none:rank_volume:nk]' pivot='key' type='nominal' />
            <column-instance column='[rank_volume]' derivation='None' name='[none:rank_volume:qk]' pivot='key' type='quantitative' />
            <column-instance column='[units]' derivation='Sum' name='[sum:units:qk]' pivot='key' type='quantitative' />
            <column-instance column='[volume]' derivation='Sum' name='[sum:volume:qk]' pivot='key' type='quantitative' />
            <column-instance column='[share_volume_pct]' derivation='Sum' name='[sum:share_volume_pct:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.agents].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.agents].[sum:units:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.agents].[sum:volume:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.agents].[sum:share_volume_pct:qk]&quot;' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.agents].[none:rank_volume:qk]' included-values='in-range'><min>1</min><max>100</max></filter>
          <slices>
            <column>[federated.agents].[:Measure Names]</column>
            <column>[federated.agents].[none:rank_volume:qk]</column>
          </slices>
          <aggregation value='true' />
