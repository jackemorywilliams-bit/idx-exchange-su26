    <worksheet name='Zip Heat - Median Price'>
      <layout-options>
        <title>
          <formatted-text><run>Median close price by zip code and month -- 60 busiest zips (darker = higher)</run></formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Competitive Sold (row-level)' name='federated.csold' />
          </datasources>

          <datasource-dependencies datasource='federated.csold'>
            <column-instance column='[CountyOrParish]' derivation='None' name='[none:CountyOrParish:nk]' pivot='key' type='nominal' />
            <column-instance column='[City]' derivation='None' name='[none:City:nk]' pivot='key' type='nominal' />
            <column-instance column='[PostalCode]' derivation='None' name='[none:PostalCode:nk]' pivot='key' type='nominal' />
            <column-instance column='[PropertySubType]' derivation='None' name='[none:PropertySubType:nk]' pivot='key' type='nominal' />
            <column-instance column='[YrMo]' derivation='None' name='[none:YrMo:nk]' pivot='key' type='nominal' />
            <column-instance column='[CloseDate]' derivation='Month-Trunc' name='[tmn:CloseDate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[zip_rank]' derivation='None' name='[none:zip_rank:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ClosePrice]' derivation='Median' name='[med:ClosePrice:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.csold].[none:CountyOrParish:nk]' filter-group='1'><groupfilter function='level-members' level='[none:CountyOrParish:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.csold].[none:City:nk]' filter-group='2'><groupfilter function='level-members' level='[none:City:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.csold].[none:PostalCode:nk]' filter-group='3'><groupfilter function='level-members' level='[none:PostalCode:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
          <filter class='categorical' column='[federated.csold].[none:PropertySubType:nk]' filter-group='4'><groupfilter function='level-members' level='[none:PropertySubType:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
